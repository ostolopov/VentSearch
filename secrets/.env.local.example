# Шаблон для локальной разработки.
# Скопируйте в secrets/.env.local и подставьте свои значения:
#   cp secrets/.env.local.example secrets/.env.local

# --- PostgreSQL (используется deploy/docker-compose.dev.yml и backend/config.py) ---
POSTGRES_USER=ventmash
POSTGRES_PASSWORD=ventpass
POSTGRES_DB=ventmash
DATABASE_URL=postgresql://ventmash:ventpass@localhost:5432/ventmash

# --- Backend ---
PORT=8000
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# --- Auth ---
# ОБЯЗАТЕЛЬНО замените на случайную строку перед реальным использованием
JWT_SECRET=change-me-in-production
JWT_EXPIRE_HOURS=168

# --- Админ-аккаунт (создаётся автоматически при первом старте) ---
ADMIN_EMAIL=admin@ventsearch.local
ADMIN_PASSWORD=admin123