+def _linear_interp(x: float, xs: List[float], ys: List[float]) -> float:
+    """Кусочно-линейная интерполяция по возрастающей сетке xs (без numpy)."""
+    if x <= xs[0]:
+        return ys[0]
+    if x >= xs[-1]:
+        return ys[-1]
+    for i in range(1, len(xs)):
+        if x <= xs[i]:
+            x0, x1 = xs[i - 1], xs[i]
+            y0, y1 = ys[i - 1], ys[i]
+            if x1 == x0:
+                return y0
+            k = (x - x0) / (x1 - x0)
+            return y0 + k * (y1 - y0)
+    return ys[-1]
+
