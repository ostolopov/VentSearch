diff --git a/frontend/style.css b/frontend/style.css
index bb389bb..b62d0dc 100644
--- a/frontend/style.css
+++ b/frontend/style.css
@@ -1692,3 +1692,57 @@ body[data-page="product"] .tabs-card .card-body {
   border-radius: 4px;
   margin-right: 0.35rem;
 }
+
+/* --- Навбар: стабильные вкладки ------------------------------------------
+   Раньше все пункты жили в одном правом (ms-auto) списке: стоило появиться
+   «Админ-панели», бейджу или кнопке «Поделиться» — и ВСЕ вкладки уезжали в
+   сторону. Теперь разделы слева (vs-nav-primary) стоят на месте всегда, а
+   аккаунт и служебные кнопки живут в правой группе (vs-nav-account). */
+.vs-nav-primary {
+  flex-wrap: nowrap;
+}
+
+/* Пункты не сжимаются и не переносят содержимое: без этого при нехватке
+   ширины (появилась вкладка «Сборки») бейдж счётчика уезжал на вторую
+   строку внутри ссылки, она становилась выше и уже — соседние вкладки
+   съезжали. */
+.vs-nav-primary > .nav-item,
+.vs-nav-account > .nav-item {
+  flex: 0 0 auto;
+}
+
+.vs-nav-primary > .nav-item > .nav-link {
+  white-space: nowrap;
+}
+
+/* Поиск в шапке — фиксированной ширины. Пока он «тянулся» вместе с блоком
+   навигации, они делили свободное место контейнера: стоило навигации стать
+   шире (появилась вкладка «Сборки») — и весь блок уезжал влево. */
+.vs-header-search {
+  flex: 0 0 260px;
+  max-width: 260px;
+}
+
+@media (max-width: 1200px) {
+  .vs-header-search {
+    flex-basis: 180px;
+    max-width: 180px;
+  }
+}
+
+.vs-nav-account {
+  flex-wrap: nowrap;
+}
+
+/* Бейджи счётчиков не выкидываем из потока, а прячем «на месте»: иначе
+   появление первой позиции в проекте сдвигало соседние вкладки. */
+.navbar .nav-project-badge.d-none,
+.navbar .nav-compare-badge.d-none {
+  display: inline-flex !important;
+  visibility: hidden;
+}
+
+/* Раздел только для сотрудников (менеджер/админ) — показывается из JS */
+.vs-nav-staff.is-staff {
+  display: block !important;
+}
