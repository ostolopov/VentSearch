Content-Transfer-Encoding: 8bit

- smooth: false для серий, построенных по квадратичной Безье и кривой сети:
  точки уже лежат на гладкой кривой, сглаживание ECharts поверх даёт
  «сплайн сплайна» (см. QP_MODEL_FOR_EGOR, п. 5.2 и чек-лист п. 4)
- обработчик window resize вешается один раз при создании графика,
  а не при каждой перерисовке (слайдер оборотов, сравнение моделей)
- поправлена ссылка на модуль α в комментарии (qp_service.py)

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Xo2pb2FaYb5UENKMhgVboE
---
 frontend/script.js | 22 +++++++++++++++-------
 1 file changed, 15 insertions(+), 7 deletions(-)

diff --git a/frontend/script.js b/frontend/script.js
index c181d59..1571932 100644
--- a/frontend/script.js
+++ b/frontend/script.js
@@ -266,7 +266,7 @@ function getRangeNominal(range) {
   return max ?? min;
 }
 
-// Параметры α по типу — синхронизированы с backend/qp_model.py
+// Параметры α по типу — синхронизированы с backend/domain/services/qp_service.py
 const ALPHA_BY_TYPE = {
   "ВО": 0.18, "ВКОП": 0.15, "УВО": 0.18,
   "ВЦ": 0.05, "ВР": 0.05, "Ц": 0.05,
@@ -324,7 +324,9 @@ function buildQpDatasetsShared(products, targetRpm = null, targetPoint = null) {
     series.push({
       name: p.model || p.id,
       type: 'line',
-      smooth: true,
+      // Точки уже лежат на квадратичной Безье (200 шт.) — дополнительное
+      // сглаживание ECharts даёт «сплайн сплайна» и артефакты (QP_MODEL, п. 5.2)
+      smooth: false,
       symbol: 'none',
       data: points,
       lineStyle: { width: 3, color: colors[idx % colors.length] },
@@ -344,7 +346,7 @@ function buildQpDatasetsShared(products, targetRpm = null, targetPoint = null) {
     series.push({
       name: 'Кривая сети',
       type: 'line',
-      smooth: true,
+      smooth: false,
       symbol: 'none',
       lineStyle: { type: 'dashed', color: '#7f7f7f', width: 2 },
       itemStyle: { color: '#7f7f7f' },
@@ -368,8 +370,10 @@ function buildQpDatasetsShared(products, targetRpm = null, targetPoint = null) {
 function renderQpChartShared(container, chartRef, products, targetRpm = null, targetPoint = null) {
   if (!container || typeof echarts === "undefined") return chartRef;
   
+  let isNewChart = false;
   if (!chartRef) {
     chartRef = echarts.init(container);
+    isNewChart = true;
   } else {
     chartRef.clear();
   }
@@ -426,10 +430,14 @@ function renderQpChartShared(container, chartRef, products, targetRpm = null, ta
 
   chartRef.setOption(option);
 
-  // Resize chart on window resize
-  window.addEventListener('resize', () => {
-    chartRef.resize();
-  });
+  // Подписываемся один раз при создании графика: повторные перерисовки
+  // (слайдер оборотов, добавление модели в сравнение) не должны копить обработчики
+  if (isNewChart) {
+    const chart = chartRef;
+    window.addEventListener('resize', () => {
+      chart.resize();
+    });
+  }
 
   return chartRef;
 }
