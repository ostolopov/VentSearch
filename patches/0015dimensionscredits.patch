+async function loadCredits() {
+  const section = $("#creditsSection");
+  if (!section) return;
+  section.innerHTML = '<div class="text-secondary small">Загрузка…</div>';
+  try {
+    const d = await va().apiAuthFetch("/api/admin/credits");
+    if (!d.found) {
