При редактировании поле id блокировалось через disabled — такие поля
браузер не включает в FormData, поэтому в payload.id попадала пустая
строка и бэкенд отклонял запрос ("String should have at least 1
character"), из-за чего не сохранялась вообще никакая правка, включая
цену. Заменили на readOnly: поле по-прежнему нельзя редактировать,
но его значение отправляется вместе с формой.

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Xo2pb2FaYb5UENKMhgVboE
---
 frontend/admin.js | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/frontend/admin.js b/frontend/admin.js
index db90f1c..c051258 100644
--- a/frontend/admin.js
+++ b/frontend/admin.js
@@ -668,7 +668,9 @@ function openProductModal(product, isCreate) {
   state.products.editingId = isCreate ? null : product?.id;
   const title = $("#productModalTitle");
   if (title) title.textContent = isCreate ? "Новый вентилятор" : `Редактирование ${product?.id}`;
-  form.elements.id.disabled = !isCreate;
+  // disabled-поля не попадают в FormData — при сохранении id ушёл бы пустой
+  // строкой и упал на валидации бэкенда; readOnly не даёт менять, но отправляется
+  form.elements.id.readOnly = !isCreate;
   fillForm(form, product ? productToForm(product) : { id: "", number: "", type: "", model: "", size: "" });
   productModal.show();
 }
